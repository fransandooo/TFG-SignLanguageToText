\label{tab:exp_scaling}
\begin{tabular}{@{}r r r r r r@{}}
\toprule
\textbf{Vocabulary} & \textbf{Train / Val / Test} & \textbf{Top-1} & \textbf{Top-5} & \textbf{Best Epoch} & \textbf{Train time (s)} \\
\midrule
